studyforge.duckdns.org {
	encode gzip

	request_body {
		max_size 21MB
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /actuator/health {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}